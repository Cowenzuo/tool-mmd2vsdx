        -PageId page_
        -ShapeId id_
    }

    class Connector {
        +id() ShapeId
        +logicalId() string
        +text() string
        +setText(text)
        +setWaypoints(points)
        -DocumentCore* core_
        -PageId page_
        -ShapeId id_
    }

    class Page {
        +id() PageId
        +name() string
        +setName(name)
        +width() double
        +height() double
        +shapeIds() ShapeId[]
        +connectorIds() ShapeId[]
