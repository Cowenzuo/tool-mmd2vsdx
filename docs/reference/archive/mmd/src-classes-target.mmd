%% ── 2c. render：渲染策略族（替代 render_dispatch 自由函数）──
namespace render {

    %% 接口贴合增量渲染语义（addShape 即渲染，公共行为不变）
    class Renderer {
        <<interface>>
        +renderShape(page, shape) void
        +renderConnector(page, connector) void
        +refreshConnectors(page, shapeId) void
    }

    class RendererFactory {
        +create(type) Renderer
    }

    class FlowchartRenderer {
        +renderShape(page, shape) void
        +renderConnector(page, connector) void
        +refreshConnectors(page, shapeId) void
    }

    class ClassDiagramRenderer {
        +renderShape(page, shape) void
