%% ═══════════════════════════ 关系（单向向下，无环） ═══════════════════════════

%% ── 0. 标准库 ──
class runtime_error {
    <<external>>
}

%% ── 1. core：IR 组合 ──
Diagram *-- Node : nodes
Diagram *-- Edge : edges
Diagram *-- Cluster : clusters
Diagram *-- BoundingBox : bounds
Edge *-- Point : waypoints
Node *-- NodeShape : shape 成员
Edge *-- EdgeStyle : style 成员
Edge *-- ArrowType : 箭头类型
Error *-- ErrorCode : code 成员
runtime_error <|-- Error

%% ── 2. opc：容器组合与依赖 ──
Package *-- OpcPart : parts_
Package *-- ContentTypes : contentTypes_
Package ..> Relationships : 序列化/解析
Package ..> ZipArchive : open/save
Package ..> ZipLimits : 安全限制
Package ..> PartUri : 部件键
Relationships *-- Relationship : items_
Relationships *-- XmlDocument : 文档模型
Relationships ..> PartUri : resolveTarget
Relationships ..> XmlUtils : 属性操作
ContentTypes *-- XmlDocument : 文档模型
ContentTypes ..> XmlUtils : 属性操作
ContentTypes ..> PartUri : contentTypeFor
ZipArchive ..> ZipEntry : 读写条目
ZipArchive ..> ZipLimits : 安全限制
ZipArchive ..> ZipError : 失败抛出
Relationship *-- RelationshipTargetMode : targetMode 成员
ZipEntry *-- ZipCompression : compression 成员
OpcPart *-- ZipCompression : compression 成员
ZipError *-- ZipErrorCode : code 成员
runtime_error <|-- ZipError

%% ── 3. api：公共门面（依赖各服务）──
Document *-- DocumentCore : Pimpl（聚合）
DocumentCore *-- DocumentModel : 模型
DocumentCore *-- Package : OPC 包（opc）
DocumentCore *-- XmlDocument : unique_ptr (documentXml/pagesXml)
DocumentCore *-- MasterLibrary : 母版服务
DocumentCore ..> Renderer : 渲染委托（接口）
DocumentCore ..> VsdxWriter : 写盘委托
DocumentCore ..> Validator : 校验委托
DocumentCore ..> CoordinateTransform : fromDiagrams 换算
Document ..> Page : page(id) 返回句柄
Document ..> CreateOptions : create/fromDiagrams
Document ..> PageSpec : addPage
Document ..> ValidationIssue : validate 返回
Page ..> Shape : shape(id) 返回句柄
Page ..> Connector : connector(id) 返回句柄
Page ..> ShapeSpec : addShape 参数
Page ..> ConnectorSpec : addConnector 参数
writeVsdx ..> Document : 便捷入口
ValidationIssue *-- ValidationSeverity : severity 成员
CreateOptions *-- DiagramType : diagramType 成员
CoordinateTransform ..> Diagram : 构造输入（core）
CoordinateTransform *-- PageMargins : margins 成员
CoordinateTransform ..> PagePoint : point 返回
CoordinateTransform *-- PageBounds : sourceBounds 成员

%% ── 句柄反向指针（句柄类持 DocumentCore*）──
Page ..> DocumentCore : 句柄指针
Shape ..> DocumentCore : 句柄指针
Connector ..> DocumentCore : 句柄指针

%% ── 4. model：内部模型（依赖 core + opc）──
DocumentModel *-- PageModel : pages
PageModel *-- ShapeModel : shapes
PageModel *-- ConnectorModel : connectors
PageModel *-- XmlDocument : unique_ptr (xml)
PageModel *-- PartUri : partUri
ShapeModel *-- ShapeStyle : style 成员
ConnectorModel *-- ShapeStyle : style 成员
ShapeSpec ..> ShapeStyle : DTO 引用（api→model）
Shape ..> ShapeStyle : setStyle 参数（api→model）

%% ── 5. render：渲染策略（依赖 model + io + masters + core）──
FlowchartRenderer ..|> Renderer : 实现
ClassDiagramRenderer ..|> Renderer : 实现
ERRenderer ..|> Renderer : 实现
RendererFactory ..> Renderer : 创建
Renderer ..> PageModel : 输出（model）
Renderer ..> ShapeModel : 输出（model）
Renderer ..> ConnectorModel : 输出（model）
FlowchartRenderer ..> ConnectorBinder : 连接线绑定
ClassDiagramRenderer ..> ConnectorBinder : 连接线绑定
ERRenderer ..> ConnectorBinder : 连接线绑定
