%% ============================================================
%% mermaid-c — 目标架构类图（to-be，重构蓝图 v2）
%% 生成时间：2026-08-04
%% 状态：已完成（2026-08-05 P0-P10 重构收官，全部落地；本图为设计历史存档，
%%       当前实现以 src-classes.mmd as-is 图为准）
%%
%% 分层（依赖单向向下，全图无环）：
%%   L0 core    纯领域模型（IR + 领域异常）—— 零依赖
%%   L1 opc     OPC 容器（ZIP/XML/Package）—— 独立模块，不依赖 core
%%   L2 vsdx    应用域：api（公共句柄）/ model（内部模型+值类型）
%%              / render（渲染策略）/ masters（母版服务）/ io（序列化）
%%   L3 parse   解析基础设施：IParser 接口 + MermaidParser + NodeJsProcess
%%   L4 app     应用门面：Mermaid（持 IParser，依赖接口）
%%
%% 设计原则：
%%   1. 单一职责：DocumentImpl 拆为 model/render/masters/io 四域 + 薄协调者
%%   2. 接口倒置：api 依赖 Renderer 接口、app 依赖 IParser 接口
%%   3. 单向依赖无环：L0←L1←L2←L3←L4，层内子系统亦无回边
%%   4. 消除镜像：IR Node/Edge 为唯一领域模型；render 直接产出 model，
%%      不再经 ShapeSpec/ConnectorSpec 中转（DTO 仅保留在公共 API 边界）
%%   5. 死代码清理：append* 几何原语与 erMultiplicityText 删除（不复活，
%%      与 v2.1 图决策一致；ER 多重性走 Relationship master + ShowMulti 机制）
%%   6. 保留务实决策：model 持有 xmlNodePtr（VSDX 即 XML，节点生命周期=
%%      所属 XmlDocument），通过访问器封装、避免跨文档共享节点
%%
%% as-is → to-be 映射（概要）：
%%   mermaidc_API         → app::Mermaid（对外保留自由函数薄包装）
%%   Engine/jsonToDiagram → parse::MermaidParser
%%   NodeProcess          → parse::NodeJsProcess
%%   DocumentImpl         → api::DocumentCore（薄协调者，持 Package+模型+服务）
%%   PageData/ShapeData/  → model::PageModel / ShapeModel / ConnectorModel
%%   ConnectorData        （PageModel 补回 relationshipId + 缓存节点）
%%   ShapeStyle           → model（值类型下沉，供 api DTO 与 model 共用）
%%   DiagramType          → 保持 api（VSDX/模具域枚举，不迁 core）
%%   render_dispatch      → render::Renderer 策略族（renderShape/renderConnector）
%%   connector_helpers    → render::ConnectorBinder（不含 erMultiplicityText）
%%   stencil_helpers/     → masters::MasterLibrary（含 resolveDiagramType）
%%   LoadedStencil
%%   opc_xml_helpers      → opc::XmlUtils
%%   低层 XML 自由函数    → io::XmlBuilder（补全清单）+ io::DocumentParts
%%   open 反序列化        → io::VsdxReader（新增，对应 openImpl）
%%   flushXmlParts/ensure → io::VsdxWriter（含原子保存文件工具）
%%   Recalc/repair
%%   validate             → io::Validator
%%   CoordinateTransform  → api（使用方为 fromDiagrams）
%% ============================================================
classDiagram
direction TB

%% ═══════════════════ L0 core：纯领域模型（零依赖） ═══════════════════
namespace core {

    class Point {
        +double x
        +double y
    }

    class BoundingBox {
        +double minX
        +double minY
        +double maxX
        +double maxY
        +width() double
        +height() double
    }

    class Node {
        +string id
        +string label
        +NodeShape shape
        +double x
        +double y
        +double width
        +double height
        +string styleClass
        +string parentId
        +double[] dividers
    }

    class Edge {
        +string from
        +string to
        +string label
        +EdgeStyle style
        +ArrowType arrowHead
        +ArrowType arrowTail
        +Point[] waypoints
        +string fromMultiplicity
        +string toMultiplicity
    }

    class Cluster {
        +string id
        +string label
        +double x
        +double y
        +double width
        +double height
    }

    %% diagramType 保持 string（mermaid 类型为开放集合，闭枚举会丢信息）
    class Diagram {
        +Node[] nodes
        +Edge[] edges
        +Cluster[] clusters
        +string diagramType
        +string direction
        +BoundingBox bounds
        +string svg
    }

    %% 枚举
    class NodeShape {
        <<enumeration>>
        Rect
        RoundRect
        Diamond
        Circle
        Ellipse
    }

    class EdgeStyle {
        <<enumeration>>
        Normal
        Dotted
        Thick
    }

    class ArrowType {
        <<enumeration>>
        None
        Arrow
        Circle
        OpenArrow
    }

    %% 领域异常（全系统唯一，各层可抛出）
    class Error {
        +ErrorCode code
        +Error(ErrorCode, string)
    }

    class ErrorCode {
        <<enumeration>>
        NodeNotFound
        JsonParseError
        SubprocessCrashed
        MermaidError
    }
}

%% ═══════════════════ L1 opc：OPC 容器（独立模块） ═══════════════════
namespace opc {

    class PartUri {
        +parse(string) PartUri
        +resolve(source, target) PartUri
        +packageRelationships() PartUri
        +sourceFromRelationships(relationshipsUri) PartUri
        +string()
        +relationshipsUri() PartUri
    }

    class XmlDocument {
        +parse(payload, name) XmlDocument
        +create(root, ns, prefix) XmlDocument
        +get() xmlDocPtr
        +root() xmlNodePtr
        +serialize() uint8[]
    }

    %% 原 opc_xml_helpers 类化
    class XmlUtils {
        <<static>>
        +isElement(node, ns, localName) bool
        +attribute(node, name) string
        +hasAttribute(node, name) bool
        +setAttribute(node, name, value)
    }

    class RelationshipTargetMode {
        <<enumeration>>
        Internal
        External
    }

    class Relationship {
        +string id
        +string type
        +string target
        +RelationshipTargetMode targetMode
    }

    class Relationships {
        +parse(payload, source) Relationships
        +create(source) Relationships
        +source() PartUri
        +items() Relationship[]
        +findById(id) Relationship
        +findByType(type) Relationship[]
        +resolveTarget(rel) PartUri
        +add(type, target, mode, id) string
        +remove(id)
        +serialize() uint8[]
    }

    class ContentTypes {
        +parse(payload) ContentTypes
        +create() ContentTypes
        +contentTypeFor(part) string
        +defaults() map<string,string>
        +overrides() map<string,string>
        +setDefault(ext, contentType)
        +setOverride(part, contentType)
        +removeOverride(part)
        +serialize() uint8[]
    }

    class ZipArchive {
        <<static>>
        +read(path, limits) ZipEntry[]
        +write(path, entries, limits)
    }

    class ZipEntry {
        +string name
        +uint8[] data
        +ZipCompression compression
    }

    class ZipLimits {
        +size_t maxEntries
        +uint64 maxArchiveBytes
        +uint64 maxEntryBytes
        +uint64 maxTotalUncompressedBytes
    }

    class ZipCompression {
        <<enumeration>>
        Store
        Deflate
    }

    class ZipErrorCode {
        <<enumeration>>
        IoError
        InvalidArchive
        UnsupportedFeature
        UnsafeEntryName
        DuplicateEntry
        CrcMismatch
        LimitExceeded
    }

    class ZipError {
        +ZipError(code, message)
        +ZipErrorCode code
    }

    class OpcPart {
        +PartUri uri
        +string contentType
        +uint8[] payload
        +ZipCompression compression
        +bool dirty
    }

    class Package {
        +open(path, limits) Package
        +create() Package
        +contains(uri) bool
        +part(uri) OpcPart
        +partUris() PartUri[]
        +addPart(uri, contentType, payload, compression)
        +removePart(uri)
        +relationships(source) Relationships
        +setRelationships(rels)
        +contentTypes() ContentTypes
        +validate()
        +save(path, limits)
    }
}

%% ═══════════════════ L2 vsdx：应用域 ═══════════════════
%% ── 2a. api：公共句柄、协调者与 DTO ──
namespace api {

    %% 句柄类（Pimpl：持有 DocumentCore*）
    class Shape {
        +id() ShapeId
        +logicalId() string
        +text() string
        +setText(text)
        +setBounds(x, y, w, h)
        +setStyle(style)
