%% ───────────────── 6. render：渲染策略族 + 连接线辅助（render*.cpp）─────────────────
namespace render {

    %% P4b：策略族。renderShape 纯虚按类型分派；renderConnector/refreshConnectors 共享
    class Renderer {
        <<interface>>
        +renderShape(page, shape)
        +renderConnector(page, connector)
        +refreshConnectors(page, shapeId)
    }

    class FlowchartRenderer {
        +renderShape(page, shape)
    }

    class ClassDiagramRenderer {
        +renderShape(page, shape)
    }

    class ERRenderer {
        +renderShape(page, shape)
    }

    class RendererFactory {
        <<static>>
        +forShape(shape, diagramType) Renderer
        +forType(diagramType) Renderer
    }

    %% P4a：连接线辅助（原 connector_helpers 类化）
    class ConnectorBinder {
        <<static>>
        +cleanWaypoints(points) Point[]
        +samePoint(a, b) bool
        +choosePort(shape, dx, dy) PortBinding
        +bindConnector(source, target, waypoints) ConnectorBinding
        +arrowValue(arrow) int
        +setConnect(connect, connectorId, fromCell, fromPart, targetId)
    }

    class PortBinding {
        +unsigned index
        +string cell
        +int toPart
        +Point point
    }

    class ConnectorBinding {
        +PortBinding begin
        +PortBinding end
        +Point[] path
    }

    %% render.cpp 薄包装：6 个跨 TU 渲染接口，委托 RendererFactory
    class render_dispatch {
        <<function>>
        +renderManagedShape(page, shape)
        +renderManagedConnector(page, connector)
