        +send(text) string
        +isRunning() bool
        +stop()
        -startProcess()
        -readLine() string
        -cleanup()
    }

    %% jsonToDiagram：glue.mjs JSON → Diagram（原 jsonparser.cpp）
    class jsonToDiagram {
        <<function>>
        +jsonToDiagram(json) Diagram
    }
}

%% ───────────────── 10. app：应用编排（app/mermaid.hpp）─────────────────
namespace app {

