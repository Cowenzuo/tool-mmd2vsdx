%% ───────────────── 9. parse：解析域（parse/*.hpp）─────────────────
namespace parse {

    %% P8：解析接口
    class IParser {
        <<interface>>
        +parse(text) Diagram
        +shutdown()
    }

    %% P8b：解析编排（原 Engine）—— NodeJsProcess → JSON → Diagram
    class MermaidParser {
        +MermaidParser(nodePath, scriptPath)
