%% ──────────────────────────── 1. core：IR 数据结构 ────────────────────────────
namespace core {

    class Point {
        +double x
        +double y
    }

    class Node {
        +string id
        +string label
        +NodeShape shape
        +double x
        +double y
        +double width
        +double height
        +string styleClass
        +string parentId
        +double[] dividers
    }

    class Edge {
        +string from
        +string to
        +string label
        +EdgeStyle style
        +ArrowType arrowHead
        +ArrowType arrowTail
        +Point[] waypoints
        +string fromMultiplicity
        +string toMultiplicity
    }

    class BoundingBox {
        +double minX
        +double minY
        +double maxX
        +double maxY
        +width() double
        +height() double
    }

    class Cluster {
        +string id
        +string label
        +double x
        +double y
        +double width
        +double height
    }

    class Diagram {
        +Node[] nodes
        +Edge[] edges
        +Cluster[] clusters
        +string diagramType
        +string direction
        +BoundingBox bounds
        +string svg
    }

    class NodeShape {
        <<enumeration>>
        Rect
        RoundRect
        Diamond
        Circle
        Ellipse
    }

    class EdgeStyle {
        <<enumeration>>
        Normal
        Dotted
        Thick
    }

    class ArrowType {
        <<enumeration>>
        None
        Arrow
        Circle
        OpenArrow
    }

    %% Error::Code 嵌套枚举（ir.hpp:101），图中以 ErrorCode 表示
    class ErrorCode {
        <<enumeration>>
        NodeNotFound
        JsonParseError
        SubprocessCrashed
        MermaidError
    }

    class Error {
        +Error::Code code
        +Error(Error::Code, string)
    }
}

%% ──────────────────────────── 2. opc：OPC/ZIP/XML ────────────────────────────
namespace opc {

    class PartUri {
        +parse(string) PartUri
        +resolve(source, target) PartUri
        +packageRelationships() PartUri
        +sourceFromRelationships(relationshipsUri) PartUri
        +string()
        +relationshipsUri() PartUri
    }

    class XmlDocument {
        +parse(payload, name) XmlDocument
        +create(root, ns, prefix) XmlDocument
        +get() xmlDocPtr
        +root() xmlNodePtr
        +serialize() uint8[]
    }

    %% P2：低层 XML 工具类化（opc::XmlUtils，取代原 4 个自由函数）
    class XmlUtils {
        <<static>>
        +isElement(node, ns, localName) bool
        +attribute(node, name) string
        +hasAttribute(node, name) bool
        +setAttribute(node, name, value)
    }

    class RelationshipTargetMode {
        <<enumeration>>
        Internal
        External
    }

    class Relationship {
        +string id
        +string type
        +string target
        +RelationshipTargetMode targetMode
    }

    class Relationships {
        +parse(payload, source) Relationships
        +create(source) Relationships
        +source() PartUri
        +items() Relationship[]
        +findById(id) Relationship
        +findByType(type) Relationship[]
        +resolveTarget(rel) PartUri
        +add(type, target, mode, id) string
        +remove(id)
        +serialize() uint8[]
    }

    class ContentTypes {
        +parse(payload) ContentTypes
        +create() ContentTypes
        +contentTypeFor(part) string
        +defaults() map<string,string>
        +overrides() map<string,string>
        +setDefault(ext, contentType)
        +setOverride(part, contentType)
        +removeOverride(part)
        +serialize() uint8[]
    }

    class ZipArchive {
        <<static>>
        +read(path, limits) ZipEntry[]
        +write(path, entries, limits)
    }

    class ZipEntry {
        +string name
        +uint8[] data
        +ZipCompression compression
    }

    class ZipLimits {
        +size_t maxEntries
        +uint64 maxArchiveBytes
        +uint64 maxEntryBytes
        +uint64 maxTotalUncompressedBytes
    }

    class ZipCompression {
        <<enumeration>>
        Store
        Deflate
    }

    class ZipErrorCode {
        <<enumeration>>
        IoError
        InvalidArchive
        UnsupportedFeature
        UnsafeEntryName
        DuplicateEntry
        CrcMismatch
        LimitExceeded
    }

    class ZipError {
        +ZipError(code, message)
        +ZipErrorCode code
    }

    class OpcPart {
        +PartUri uri
        +string contentType
        +uint8[] payload
        +ZipCompression compression
        +bool dirty
    }

    class Package {
        +open(path, limits) Package
        +create() Package
        +contains(uri) bool
        +part(uri) OpcPart
        +partUris() PartUri[]
        +addPart(uri, contentType, payload, compression)
        +removePart(uri)
        +relationships(source) Relationships
        +setRelationships(rels)
        +contentTypes() ContentTypes
        +validate()
        +save(path, limits)
    }
}

