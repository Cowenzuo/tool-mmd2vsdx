{
  "name": "mmd2vsdx",
  "version": "0.1.0-alpha1",
  "description": "Mermaid → Visio VSDX converter (pure Node/TypeScript port of the verified C++17 mmd2vsdx engine)",
  "type": "module",
  "private": true,
  "main": "./dist/app/application.js",
  "types": "./dist/app/application.d.ts",
  "bin": {
    "mmd2vsdx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:arch": "node scripts/check-architecture.mjs",
    "make:fixtures": "node scripts/make-fixtures.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "mermaid": "10.9.8",
    "playwright": "1.61.1"
  }
}
